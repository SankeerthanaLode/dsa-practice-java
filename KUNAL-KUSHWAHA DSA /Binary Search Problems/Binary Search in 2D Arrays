import java.util.*;

public class Main{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[][] nums = {
            {10, 20, 30, 40},
            {15, 25, 35, 45},
            {28, 29, 37, 49},
            {33, 34, 38, 50}
        };
        int target = 51;

        boolean is_found = binSearch(nums, target);

        if(is_found){
            System.out.println("Found the element");
        }else{
            System.out.println("Not found");
        }

        sc.close();
    }

    static boolean binSearch(int[][] nums, int target){
        int row = 0;
        int col = nums.length - 1;

        while(row < nums.length && col >= 0){
            if(nums[row][col] == target){
                return true;
            }else if(nums[row][col] < target){
                row++;
            }else{
                col--;
            }
        }

        return false;
    }
}


//THE ABOVE ISNT THE ACTUAL BINARY SEARCH ON 2D ARRAYS, THE BELOW SOLUTION IS THE BINARY SEARCH CODE ON 2D ARRAYS

class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int rows = matrix.length;
        int cols = matrix[0].length;

        int low = 0;
        int high = (rows * cols) - 1;

        while(low <= high){
            int mid = low + (high - low)/2;

            int r = mid / cols;
            int c = mid % cols;

            if(matrix[r][c] == target){
                return true;
            }else if(matrix[r][c] < target){
                low = mid + 1;
            }else{
                high = mid - 1;
            }
        }

        return false;
    }
}
