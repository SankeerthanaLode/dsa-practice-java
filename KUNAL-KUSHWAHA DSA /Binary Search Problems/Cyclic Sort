import java.util.*;

public class Main{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[] nums = {3, 5, 2, 1, 4};
        int i = 0;

        while(i < nums.length){
            if(nums[i] - 1 != i){
                swap(nums, i, nums[i] - 1);
            }else{
                i++;
            }
        }

        System.out.println(Arrays.toString(nums));

        sc.close();
    }

    static void swap(int[] nums, int a, int b){
        int temp = nums[a];
        nums[a] = nums[b];
        nums[b] = temp;

        return;
    }

}



