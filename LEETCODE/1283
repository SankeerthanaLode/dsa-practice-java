class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        int start = 1;
        int end = nums[0];

        for(int i = 1; i < nums.length; i++){
            end = Math.max(end, nums[i]);
        }

        while(start <= end){
            int sum = 0;
            int mid = (start + end)/2;

            for(int j = 0; j < nums.length; j++){
                sum = sum + (mid + nums[j] - 1)/mid;
            }

            if(sum <= threshold){
                end = mid - 1;
            }else{
                start = mid + 1;
            }

        }

        return start;
    }
}
