class Solution {
    public int mySqrt(int x) {

        if(x == 1){
            return 1;
        }

        int left = 1;
        int right = x/2;

        while(left <= right){
            int mid = left + (right - left)/2;

            if(mid == x/mid && x % mid == 0){
                return mid;
            }else if(mid > x / mid){
                right = mid - 1;
            }else{
                left = mid + 1;
            }
        }

        return right;
    }
}
