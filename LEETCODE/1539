class Solution {
    public int findKthPositive(int[] arr, int k) {
        int count = 0;

        int i = 1;
        int j = 0;

        while(i <= 2001){
            if(j < arr.length && arr[j] == i){
                j++;
            }else{
                count++;
            }

            if(count == k){
                return i;
            }
            
            i++;
        }

        return i;
    }
}


//Yet Another solution

class Solution {
    public int findKthPositive(int[] arr, int k) {
        int count = arr[0] - 1;
        int cnt = 0;

        for(int i = 1; i < arr.length; i++){
            count = count + (arr[i] - arr[i - 1] - 1);
        }

        if(count == 0){
            return arr[arr.length - 1] + k;
        }else{
            int s = 0;
            for(int j = 1; j <= arr[arr.length - 1] + k; j++){

                if(s < arr.length && arr[s] == j){
                    s++;
                }else{
                    cnt++;
                }

                if(cnt == k){
                    return j;
                }
            }
        }

        return count;
    }
}
