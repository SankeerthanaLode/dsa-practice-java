class Solution {
    public int shipWithinDays(int[] weights, int days) {
        int start = 0;
        int end = 0;
        int count_days = 0;

        for(int i = 0; i < weights.length; i++){
            start = Math.max(start, weights[i]);
            end += weights[i];
        }

        while(start < end){
            int mid = start + (end - start)/2;

            count_days = numberOfDays(weights, mid);

            if(count_days <= days){
                end = mid;
            }else{
                start = mid + 1;
            }
        }

        return start;
    }

    static int numberOfDays(int[] weights, int mid){

        int sum = 0;
        int count_days = 0;

        for(int j = 0; j < weights.length; j++){
                sum += weights[j];

                if(sum < mid){
                    if(j == weights.length - 1){
                        count_days++;
                    }
                    continue;
                }else if(sum == mid){
                    count_days++;
                    sum = 0;
                }else{
                    count_days++;
                    sum = weights[j];
                    if(j == weights.length - 1){
                        count_days++;
                    }
                }
            }

        return count_days;
    }
}
