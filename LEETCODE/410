class Solution {
    public int splitArray(int[] nums, int k) {
        int start = 0;
        int end = 0;
        int mid;
        int m;

        for(int i = 0; i < nums.length; i++){
            start = Math.max(start, nums[i]);
            end += nums[i];
        }

        while(start < end){
            mid = (start + end)/2;

            m = findPieces(nums, mid);

            if(m <= k){
                end = mid;
            }else{
                start = mid + 1;
            }
            
        }

        return start;
    }

    static int findPieces(int[] nums, int value){
        int pieces = 1;
        int sum = 0;

        for(int i = 0; i < nums.length; i++){
            sum += nums[i];
            if(sum > value){
                pieces++;
                sum = nums[i];
            }
        }

        return pieces;
    }
}
