class Solution {
    public int missingNumber(int[] nums) {
        int n = nums.length;
        int max = (n * (n + 1))/2;
        int sum = 0;

        for(int i = 0; i < nums.length; i++){
            sum += nums[i];
        }

        return max - sum;
    }

}



#ANOTHER APPROACH - USING CYCLIC SORT

class Solution {
    public int missingNumber(int[] nums) {
        int i = 0;

        while(i < nums.length){
            if(nums[i] < nums.length && nums[i] != nums[nums[i]]){
                swap(nums, i, nums[i]);
            }else{
                i++;
            }
        }

        for(i = 0; i < nums.length; i++){
            if(nums[i] != i){
                return i;
            }
        }

        return nums.length;
    }

    static void swap(int[] nums, int a, int b){
        int temp = nums[a];
        nums[a] = nums[b];
        nums[b] = temp;

        return;
    }
}
